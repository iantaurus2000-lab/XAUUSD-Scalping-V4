<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#05080C" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XAUUSD  •  MOBILE TRADING ENGINE" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/connection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● MARKET OFFLINE" android:textColor="#C5D0DA" android:textSize="11sp"/>
        </LinearLayout>
        <Button android:id="@+id/btnMenu" android:layout_width="48dp" android:layout_height="44dp" android:text="☰" android:textSize="18sp" android:textColor="#FFFFFF" android:background="#16202B"/>
    </LinearLayout>
    <TextView android:id="@+id/ticker" android:layout_width="match_parent" android:layout_height="22dp" android:text="BIQUOTE • XAUUSD • LIVE 1s" android:textColor="#FFC107" android:textSize="10sp" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:focusable="true" android:focusableInTouchMode="true" android:scrollHorizontally="true"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom">
        <TextView android:id="@+id/price" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="----.--" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="right">
            <TextView android:id="@+id/priceChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.00" android:textColor="#00E676" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/spreadLine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spread --" android:textColor="#C8D3DC" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/highLow" android:layout_width="match_parent" android:layout_height="20dp" android:text="H --   L --" android:textColor="#D7E0E8" android:textSize="11sp"/>
    <TextView android:id="@+id/resultsBar" android:layout_width="match_parent" android:layout_height="20dp" android:text="ENGINE • Win 0 • Loss 0 • WR 0%" android:textColor="#80CBC4" android:textSize="10sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:background="#0F1620" android:padding="7dp" android:gravity="center_vertical">
        <TextView android:id="@+id/lamp" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="●" android:textColor="#78909C" android:textSize="28sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/signalState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WAIT • SCORE 0/100" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/confidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="☆☆☆☆☆ 0/100" android:textColor="#00E676" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:background="#0F1620" android:padding="5dp">
        <TextView android:id="@+id/boxEntry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ENTRY&#10;--" android:textColor="#FFFFFF" android:textSize="10sp"/>
        <TextView android:id="@+id/boxSl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="SL&#10;--" android:textColor="#EF5350" android:textSize="10sp"/>
        <TextView android:id="@+id/boxTp1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="TP1&#10;--" android:textColor="#66BB6A" android:textSize="10sp"/>
        <TextView android:id="@+id/boxTp2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="TP2&#10;--" android:textColor="#26C6DA" android:textSize="10sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp">
        <Button android:id="@+id/btnCopyEntry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ENTRY" android:textSize="11sp"/>
        <Button android:id="@+id/btnCopySl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⧉" android:textSize="14sp" android:layout_marginStart="3dp"/>
        <Button android:id="@+id/btnCopyTp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⧉" android:textSize="14sp" android:layout_marginStart="3dp"/>
        <TextView android:id="@+id/m5Bias" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="M5 WAIT" android:textColor="#80CBC4" android:textSize="9sp"/>
        <TextView android:id="@+id/m1State" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="M1 WATCH" android:textColor="#80CBC4" android:textSize="9sp"/>
    </LinearLayout>
    <TextView android:id="@+id/signalDetail" android:layout_width="match_parent" android:layout_height="30dp" android:text="M5 Bias → Liquidity Sweep → Wick Rejection → BOS" android:textColor="#FFD54F" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:focusable="true" android:focusableInTouchMode="true" android:scrollHorizontally="true"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp">
        <Button android:id="@+id/tfM1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M1" android:textSize="10sp"/>
        <Button android:id="@+id/tfM5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M5" android:textSize="10sp" android:layout_marginStart="3dp"/>
        <Button android:id="@+id/tfM15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M15" android:textSize="10sp" android:layout_marginStart="3dp"/>
        <Button android:id="@+id/btnLive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="● LIVE" android:textSize="10sp" android:layout_marginStart="3dp"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/chartHost" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp">
        <Button android:id="@+id/btnExness" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🔐 EXNESS" android:textSize="10sp"/>
        <Button android:id="@+id/btnManual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🎯 MANUAL LIMIT" android:textSize="10sp" android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▶ START AUTO" android:textColor="#FFFFFF" android:background="#1B5E20" android:textSize="10sp"/>
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="■ STOP" android:textColor="#FFFFFF" android:background="#B71C1C" android:textSize="10sp" android:layout_marginStart="5dp"/>
        <Button android:id="@+id/btnCancelAuto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🛑 CANCEL AUTO" android:textColor="#FFFFFF" android:background="#4A171C" android:textSize="9sp" android:layout_marginStart="5dp"/>
    </LinearLayout>
    <TextView android:id="@+id/botState" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="AUTO: OFF • MANUAL" android:textColor="#FFFFFF" android:textSize="9sp"/>
    <TextView android:id="@+id/account" android:layout_width="match_parent" android:layout_height="18dp" android:text="Account: not connected" android:textColor="#78909C" android:textSize="9sp"/>
    <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="22dp" android:text="Ready • engine active • auto OFF" android:textColor="#AAB7C4" android:textSize="9sp"/>
</LinearLayout>